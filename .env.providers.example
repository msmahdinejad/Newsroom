# Canonical editorial router configuration template.
# Copy to `.env.providers.local`; the local file is ignored by Git.
# Keep access values blank until a bounded live validation is ready.

LLM_ROUTER_ENABLED=false
LLM_PROVIDER_ORDER=gemini,mistral,groq,nvidia
LLM_QUEUE_SIZE=32
LLM_PROVIDER_COOLDOWN_SECONDS=300
LLM_KEY_COOLDOWN_SECONDS=60
LLM_TRANSIENT_RETRY_JITTER_SECONDS=0.25
LLM_MAX_ROUTE_ATTEMPTS=64
LLM_RATE_HEADROOM=0.8
# Optional shared egress route. Keep blank for direct provider access.
LLM_PROXY_URL=
# Optional Docker-only rewrite for a loopback proxy URL. This is a hostname,
# not a credential. Leave blank unless the host proxy is reachable via Docker.
LLM_PROXY_CONTAINER_HOST=

# Comma-separated values are supported. Never commit real values.
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
GROQ_API_KEYS=
NVIDIA_API_KEYS=

# Leave model lists blank to use the audited built-in candidates.
GEMINI_MODELS=
MISTRAL_MODELS=
GROQ_MODELS=
NVIDIA_MODELS=

# Leave API bases blank to use provider defaults.
GEMINI_API_BASE=
MISTRAL_API_BASE=
GROQ_API_BASE=
NVIDIA_API_BASE=

# Keys share these quota scopes unless independently provisioned scopes are
# explicitly demonstrated. Labels must not contain protected values.
GEMINI_QUOTA_SCOPE=gemini-project-default
MISTRAL_QUOTA_SCOPE=mistral-project-default
GROQ_QUOTA_SCOPE=groq-project-default
NVIDIA_QUOTA_SCOPE=nvidia-project-default

# Gemini advertised limits and conservative production headroom.
GEMINI_LIMIT_RPM=15
GEMINI_LIMIT_TPM=250000
GEMINI_LIMIT_RPD=500
GEMINI_RPD_HEADROOM=0.9
LLM_GEMINI_CONCURRENCY=1
GEMINI_MIN_REQUEST_SPACING_SECONDS=5

# Optional provider-specific ceilings. Adjust only to documented account limits.
MISTRAL_LIMIT_RPM=60
MISTRAL_LIMIT_TPM=1000000
MISTRAL_LIMIT_RPD=1000
LLM_MISTRAL_CONCURRENCY=1
MISTRAL_MIN_REQUEST_SPACING_SECONDS=0

GROQ_LIMIT_RPM=60
GROQ_LIMIT_TPM=1000000
GROQ_LIMIT_RPD=1000
LLM_GROQ_CONCURRENCY=1
GROQ_MIN_REQUEST_SPACING_SECONDS=0

NVIDIA_LIMIT_RPM=60
NVIDIA_LIMIT_TPM=1000000
NVIDIA_LIMIT_RPD=1000
LLM_NVIDIA_CONCURRENCY=1
NVIDIA_MIN_REQUEST_SPACING_SECONDS=0
