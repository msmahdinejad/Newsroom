    "schedule_error": "\u274c \u062f\u0631\u06cc\u0627\u0641\u062a \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f\u06cc \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062f.",
    "settings_saved": "\u2705 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0630\u062e\u06cc\u0631\u0647 \u0634\u062f.",
