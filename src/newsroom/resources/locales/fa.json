    "source_delete_confirm": "\u26a0\ufe0f \u0628\u0631\u0627\u06cc \u0622\u0631\u0634\u06cc\u0648 \u0645\u0646\u0628\u0639\u060c \u062f\u0633\u062a\u0648\u0631 \u0631\u0627 \u0628\u0627 confirm \u062a\u06a9\u0631\u0627\u0631 \u06a9\u0646\u06cc\u062f:\n/source delete {source_id} confirm",
