  "messages": {
    "ai_unavailable": "\u23f3 \u0647\u06cc\u0686 \u0645\u0633\u06cc\u0631 \u0645\u0639\u062a\u0628\u0631 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u067e\u0627\u0633\u062e \u0642\u0627\u0628\u0644\u200c\u0642\u0628\u0648\u0644 \u0646\u062f\u0627\u062f\u061b \u06af\u0632\u0627\u0631\u0634 \u0628\u06cc\u200c\u06a9\u06cc\u0641\u06cc\u062a \u0627\u0631\u0633\u0627\u0644 \u0646\u0634\u062f.",
