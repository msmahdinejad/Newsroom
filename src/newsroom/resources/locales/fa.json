    "cooldown": "\u23f3 \u06cc\u06a9 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0627\u062e\u06cc\u0631 \u0647\u0646\u0648\u0632 \u0645\u0639\u062a\u0628\u0631 \u0627\u0633\u062a\u061b \u0686\u0646\u062f \u062f\u0642\u06cc\u0642\u0647 \u062f\u06cc\u06af\u0631 \u062f\u0648\u0628\u0627\u0631\u0647 \u062a\u0644\u0627\u0634 \u06a9\u0646\u06cc\u062f.",
