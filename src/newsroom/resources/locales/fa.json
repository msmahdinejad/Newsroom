    "collect_error": "\u274c \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u0645\u0646\u0627\u0628\u0639 \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062f.",
