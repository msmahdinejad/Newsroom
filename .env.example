# Newsroom application configuration
#
# Copy this file to `.env`, or run `python scripts/bootstrap.py`.
# This public template contains no credentials. Replace every `change-me`
# value before running a shared or internet-accessible deployment.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://newsroom:change-me@127.0.0.1:55432/newsroom
POSTGRES_PASSWORD=change-me
NEWSROOM_POSTGRES_HOST_PORT=55432

# Runtime and logging
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE=Asia/Tehran
PIPELINE_LOCK_TIMEOUT=300
RAW_RETENTION_DAYS=30
NORMALIZED_RETENTION_DAYS=90

# Collection
COLLECTION_TIMEOUT_CONNECT=30
COLLECTION_TIMEOUT_READ=60
COLLECTION_MAX_SIZE_MB=2
COLLECTION_USER_AGENT=newsroom/3.0
COLLECTION_PROXY_URL=
COLLECT_CONCURRENCY=4
COLLECT_LIMIT_PER_SOURCE=10
COLLECT_MAX_SOURCES_PER_CYCLE=20
COLLECT_SOURCE_SPACING_SECONDS=1
COLLECT_RETRY_BASE_DELAY_SECONDS=5
COLLECT_RETRY_MAX_DELAY_SECONDS=3600
COLLECT_LOOP_SECONDS=900

# Processing
DEDUP_TIME_WINDOW_HOURS=24
CLUSTER_KEYWORD_THRESHOLD=0.35
PROCESSING_BATCH_SIZE=500
PROCESSING_LOOP_SECONDS=60
PROCESSING_PRIORITY_SOURCE_TYPE=telegram

# Report scheduling and generation
SCHEDULE_REPORT_HOURS=0,6,12,18
MANUAL_COOLDOWN_SECONDS=600
EDITORIAL_ENABLED=false
EDITORIAL_TIMEOUT_SECONDS=60
EDITORIAL_MAX_RETRIES=2
EDITORIAL_MAX_INPUT_TOKENS=12000
EDITORIAL_MAX_OUTPUT_TOKENS=8000
EDITORIAL_TEMPERATURE=0.3
EDITORIAL_FALLBACK_ENABLED=true
EDITORIAL_MAX_STORIES_PER_CALL=15
EDITORIAL_MAX_EVIDENCE_PER_STORY=10
EDITORIAL_MAX_EXCERPT_LENGTH=300
EDITORIAL_MIN_TELEGRAM_STORIES=2
EDITORIAL_CONCURRENCY_LIMIT=1
EDITORIAL_SCHEDULED_RUN_BUDGET=1
EDITORIAL_MANUAL_RUN_BUDGET=3
EDITORIAL_MAX_STORIES_PER_SHARD=8
EDITORIAL_MAX_MAP_CALLS_PER_REPORT=12
EDITORIAL_MAX_REDUCTION_CALLS_PER_REPORT=4
EDITORIAL_MAX_HIERARCHY_DEPTH=3
EDITORIAL_MAX_CONCURRENT_MAP=2
EDITORIAL_MAX_TOTAL_INPUT_TOKENS_PER_REPORT=100000
EDITORIAL_MAX_TOTAL_OUTPUT_TOKENS_PER_REPORT=30000
EDITORIAL_SHARD_INPUT_TOKEN_LIMIT=8000
EDITORIAL_SHARD_OUTPUT_TOKEN_LIMIT=4000
EDITORIAL_MAX_PENDING_JOBS=3
EDITORIAL_STALE_JOB_TIMEOUT_SECONDS=600

# Telegram output bot
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_IDS=
TELEGRAM_CHAT_ID=
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_CHUNK_SIZE=3800
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=1

# Telegram MTProto ingestion
# Authorize once with:
# docker compose --profile authorize run --rm telegram-authorize
TELEGRAM_INGESTOR_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/sessions/newsroom_ingestor.session
TELEGRAM_CONNECT_TIMEOUT_SECONDS=12
TELEGRAM_CONNECTION_RETRIES=1
TELEGRAM_RETRY_DELAY_SECONDS=2
TELEGRAM_RECONNECT_COOLDOWN_SECONDS=300
TELEGRAM_MAX_SOURCES_PER_CYCLE=20
TELEGRAM_SOURCE_SPACING_SECONDS=1
TELEGRAM_CONNECTION_MODE=direct
TELEGRAM_PROXY_URL=
TELEGRAM_PROXY_TYPE=
TELEGRAM_MTPROXY_HOST=
TELEGRAM_MTPROXY_PORT=0
TELEGRAM_MTPROXY_SECRET=

# Optional Agent-Reach and X ingestion
# X cookies belong only in `.env.x.local`.
AGENT_REACH_ENABLED=false
AGENT_REACH_ALLOW_AUTHENTICATED_CHANNELS=false
AGENT_REACH_WORKER_ALLOWED_CHANNELS=web,rss,github,youtube
AGENT_REACH_TIMEOUT_SECONDS=60
AGENT_REACH_MAX_OUTPUT_BYTES=2097152
AGENT_REACH_MAX_RETRIES=1
AGENT_REACH_CONCURRENCY_LIMIT=2
AGENT_REACH_HEALTH_INTERVAL_SECONDS=300
X_WORKER_POLL_SECONDS=900
X_WORKER_BATCH_SIZE=12
X_WORKER_SPACING_SECONDS=2
