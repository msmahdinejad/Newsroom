# Database — use 127.0.0.1 not localhost (Windows IPv6 fix)
DATABASE_URL=postgresql+psycopg://newsroom:newsroom_dev@127.0.0.1:55432/newsroom
POSTGRES_PASSWORD=newsroom_dev
NEWSROOM_POSTGRES_HOST_PORT=55432

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Collection
COLLECTION_TIMEOUT_CONNECT=30
COLLECTION_TIMEOUT_READ=60
COLLECTION_MAX_SIZE_MB=2

# Processing
DEDUP_TIME_WINDOW_HOURS=24
CLUSTER_KEYWORD_THRESHOLD=0.35

# Telegram output bot (Gate 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_USER_IDS=
TELEGRAM_CHAT_ID=
# Gate 1 default: disabled. Enable explicitly in Gate 2.
TELEGRAM_BOT_ENABLED=false
# Gate 2 delivery config
TELEGRAM_CHUNK_SIZE=3800
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=1.0
TELEGRAM_TEST_CHAT_ID=

# Telegram MTProto (source collector — Gate 3, NOT Gate 2)
# One-time authorization: run `newsroom authorize-telegram` locally.
# Login code and 2FA password are entered interactively — never stored in .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/sessions/newsroom_ingestor.session
TELEGRAM_INGESTOR_ENABLED=false

# Manual report cooldown (seconds)
MANUAL_COOLDOWN_SECONDS=600

# Gate 4: AI editorial layer
# Default: disabled. Deterministic provider always works without credentials.
# To enable: set EDITORIAL_ENABLED=true, EDITORIAL_PROVIDER=openai_compatible,
# EDITORIAL_MODEL=<your model>, EDITORIAL_API_KEY=<your key>,
# EDITORIAL_API_BASE=<OpenAI-compatible base URL>.
# Safe effective limits: the adapter caps max_output_tokens at 8192 and
# max_input_tokens at 128000 regardless of the configured value, so
# provider-incompatible limits are never sent. See GATE_4_COST_AND_LIMITS.md.
EDITORIAL_ENABLED=false
EDITORIAL_PROVIDER=deterministic
EDITORIAL_MODEL=
EDITORIAL_API_BASE=https://api.openai.com/v1
EDITORIAL_API_KEY=
EDITORIAL_TIMEOUT_SECONDS=60
EDITORIAL_MAX_RETRIES=2
EDITORIAL_MAX_INPUT_TOKENS=12000
EDITORIAL_MAX_OUTPUT_TOKENS=4000
EDITORIAL_TEMPERATURE=0.3
EDITORIAL_FALLBACK_ENABLED=true
EDITORIAL_MAX_STORIES_PER_CALL=15
EDITORIAL_MAX_EVIDENCE_PER_STORY=10
EDITORIAL_MAX_EXCERPT_LENGTH=300
EDITORIAL_CONCURRENCY_LIMIT=1
EDITORIAL_SCHEDULED_RUN_BUDGET=1
EDITORIAL_MANUAL_RUN_BUDGET=3

# Gate 5: Agent-Reach capability layer (external internet/social platforms)
# Agent-Reach is a capability-selection, diagnostics, and backend-routing layer.
# Newsroom owns source config, cursors, retries, normalization, persistence, security.
# Default: disabled. Enable explicitly after audit + install + doctor pass.
AGENT_REACH_ENABLED=false
# Executable name on PATH, or absolute path. The controlled runner invokes it
# with shell=False and a sanitized environment.
AGENT_REACH_EXECUTABLE=agent-reach
# Isolated writable config directory for the worker. Must not be the host home.
# Cookies/tokens live here with file permission 600 — never committed, never shared.
AGENT_REACH_CONFIG_DIR=./data/agent-reach
AGENT_REACH_TIMEOUT_SECONDS=60
AGENT_REACH_MAX_OUTPUT_BYTES=2097152
AGENT_REACH_MAX_RETRIES=1
AGENT_REACH_CONCURRENCY_LIMIT=2
# Channel allowlist — comma-separated. Default set is the unauthenticated-safe scope.
# Channels requiring authentication (X cookies, Reddit login, IG, FB) are off by default.
AGENT_REACH_ALLOWED_CHANNELS=web,rss,github,youtube
# Required for production: an immutable Agent-Reach revision (release tag, package
# version, or commit SHA). Never depend on mutable `main`. No auto self-updates.
# Audit record: docs/verification/GATE_5_AGENT_REACH_AUDIT.md
AGENT_REACH_PINNED_VERSION=
# Allow authenticated channels (cookies/tokens). Default false — owner must opt in,
# and dedicated operational accounts must be used (never the primary account).
AGENT_REACH_ALLOW_AUTHENTICATED_CHANNELS=false
AGENT_REACH_HEALTH_INTERVAL_SECONDS=300
