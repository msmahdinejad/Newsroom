# Environment Configuration

# Database
DATABASE_URL=postgresql://newsroom:newsroom_dev_password@localhost:5432/newsroom
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Collection
COLLECTION_TIMEOUT_CONNECT=30
COLLECTION_TIMEOUT_READ=60
COLLECTION_MAX_CONTENT_LENGTH=1048576
COLLECTION_MAX_ITEMS_PER_FETCH=1000
COLLECTION_USER_AGENT=NewsroomBot/1.0 (+https://example.com/bot)

# Processing
PROCESSING_BATCH_SIZE=100
CLUSTERING_TIME_WINDOW_HOURS=24
CLUSTERING_KEYWORD_OVERLAP_THRESHOLD=0.5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/newsroom.log

# GitHub (Optional - for higher rate limits in future)
# GITHUB_TOKEN=ghp_your_token_here

# Future: Telegram, X, etc
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_NAME=
